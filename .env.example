APP_NAME="Travel Platform"
# IMPORTANT: For production set APP_ENV=production and APP_DEBUG=false (never expose stack traces)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
# PRODUCTION: APP_URL=https://api.yourdomain.com  FRONTEND_URL=https://yourdomain.com
FRONTEND_URL=http://localhost:5173,http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,localhost:8000,127.0.0.1:5173,127.0.0.1:8000
# PRODUCTION: SANCTUM_STATEFUL_DOMAINS=yourdomain.com,api.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# PRODUCTION: LOG_LEVEL=warning  LOG_STACK=daily (prevents single file growing unbounded)

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# SERVER MySQL (uncomment on server, then php artisan migrate --seed):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tour_and_travel
# DB_USERNAME=root
# DB_PASSWORD=your_mysql_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# PRODUCTION: SESSION_ENCRYPT=true  SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: SESSION_DOMAIN=.yourdomain.com  SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=travel_platform

# Payments - set in Admin -> Company Settings -> Tokens & Keys (tokens.*)
# tokens.esewa_merchant_code, tokens.esewa_secret, tokens.khalti_public_key, tokens.khalti_secret
# tokens.stripe_publishable, tokens.stripe_secret, tokens.payment_mock_enabled=true for local mock
# When empty, Payment verify runs safe mock (requires pending payment + TEST_OK prefix)
# PRODUCTION: Set tokens.payment_mock_enabled=false in Admin and PAYMENT_MOCK_ENABLED=false below
PAYMENT_MOCK_ENABLED=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
